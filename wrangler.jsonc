{
  // "name" must match the Worker this repo is connected to in the Cloudflare
  // dashboard. If the build targets the wrong Worker, change it here.
  "name": "crypticx",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  // Without this, every deploy deletes the plain-text variables set in the
  // dashboard, because wrangler treats this file as the whole truth about
  // bindings and no vars are declared here. The Firebase keys are configured
  // in the dashboard on purpose, so they must survive deploys.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /env.js is generated by the Worker from environment variables; without
    // this, the blank public/env.js placeholder would shadow it.
    "run_worker_first": ["/env.js"]
  }
}
