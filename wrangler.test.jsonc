{
  // "name" must match the Worker this repo is connected to in the Cloudflare
  // dashboard. If the build targets the wrong Worker, change it here.
  "name": "crypticx",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  // ---------------------------------------------------------------------
  // FILL THESE IN — copy the four values from the Firebase console under
  // Project settings → General → Your apps → SDK setup and configuration.
  // Sign-in stays disabled until apiKey, authDomain and projectId are set.
  //
  // These are committed on purpose. The Firebase web config is not a secret:
  // it is served to every visitor's browser, and always was. What protects
  // the project is the authorised-domain list and the Firebase security
  // rules, not hiding these strings. Keeping them here means preview builds
  // and production behave the same, with no dashboard step to get wrong.
  //
  // Real credentials — anything that must not be in a public repo, like the
  // watch username and password — stay in the dashboard under Settings →
  // Variables and Secrets. keep_vars below stops deploys from clearing them.
  // ---------------------------------------------------------------------
  "vars": {
    "FIREBASE_API_KEY": "AIzaFROMCONFIG",
    "FIREBASE_AUTH_DOMAIN": "demo.firebaseapp.com",
    "FIREBASE_PROJECT_ID": "demo-proj",
    "FIREBASE_APP_ID": "1:123:web:abc",
    "WATCH_URL": "https://watch.arkia.buzz/web/"
  },

  // Variables set in the dashboard are deleted on deploy unless they are
  // declared above; this keeps the ones that are deliberately not in here.
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /env.js is generated by the Worker from the vars above plus anything
    // set in the dashboard; without this, the blank public/env.js placeholder
    // would shadow it.
    "run_worker_first": ["/env.js"]
  }
}
